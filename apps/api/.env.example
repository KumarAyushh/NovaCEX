# api settings. Setup: cp .env.example .env  then fill in the <...> values.
# REDIS_URL and DATABASE_URL come from the root .env (loaded first).
# Lines marked "optional" can be removed to use the default shown.

# Required. Signs login tokens. Generate: openssl rand -hex 32
JWT_ACCESS_SECRET=<random-64-hex-chars>

# Optional.
PORT=3000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173
ENABLE_FAUCET=true
ENGINE_TIMEOUT_MS=5000
