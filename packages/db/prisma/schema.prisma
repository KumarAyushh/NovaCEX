// NovaCEX Postgres schema (section 4.7 of CLAUDE.md).
//
// Postgres holds durable HISTORY and identities only. Live trading state
// (balances, open orders, books) lives in the engine's memory and is never
// read from here. Writers:
//   api        users, refresh tokens (P4)
//   persister  orders, fills, ledger, candles (P6)
//
// P0.5 adds only `User`. The other tables arrive with the phase that needs
// them, each through its own migration.

generator client {
  
  provider     = "prisma-client"
  output       = "../generated/prisma"
  runtime      = "bun"
  moduleFormat = "esm"
}


datasource db {
  provider = "postgresql"
}


/// A trading account. Created by `POST /v1/auth/signup` (P4.2).

model User { 
  id           String   @id @default(uuid(7)) @db.Uuid 
  username     String   @unique 
  passwordHash String   @map("password_hash") 
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@map("users")
}
