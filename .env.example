# Template for the root `.env` used by docker-compose.yml.
# This file is committed, so it holds PLACEHOLDERS ONLY, never real values.
#
# Setup:  cp .env.example .env   then replace every <...> below.
# `.env` is gitignored. docker-compose.yml has no defaults, so `make up`
# refuses to start until every variable here is set.

# --- Redis ---
# Host port mapped to the container's 6379 (bound to 127.0.0.1 only).
REDIS_PORT=<redis-host-port>
# Redis login. The default (no-password) user is turned off.
# Keep both URL-safe (letters, digits, - _ . ~), e.g. `openssl rand -hex 24`.
REDIS_USERNAME=<redis-user>
REDIS_PASSWORD=<redis-password>
# AOF fsync policy: everysec | always (always is used by the chaos test, P5.5)
REDIS_APPENDFSYNC=<everysec-or-always>
# Used by every app. Copy AS IS: Bun fills each ${...} from above.
REDIS_URL=redis://${REDIS_USERNAME}:${REDIS_PASSWORD}@127.0.0.1:${REDIS_PORT}

# --- Postgres ---
# Host port mapped to the container's 5432 (bound to 127.0.0.1 only).
POSTGRES_PORT=<postgres-host-port>
POSTGRES_USER=<postgres-user>
# Use a long random value, e.g. `openssl rand -hex 24`.
POSTGRES_PASSWORD=<postgres-password>
POSTGRES_DB=<postgres-database-name>

# Connection string for Prisma (packages/db) and later the api/persister.
# Copy this line AS IS: it holds no values of its own. Bun expands each
# ${...} from the variables above when it loads this file, so the password
# lives in exactly one place. Keep the password URL-safe (hex is), or it
# must be percent-encoded here.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}${POSTGRES_PORT}/${POSTGRES_DB}
