{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "generate": {
      "inputs": ["prisma/schema.prisma", "prisma.config.ts"],
      "outputs": ["generated/**"]
    },

    "typecheck": {
      "dependsOn": ["generate", "^generate", "^typecheck"]
    },

    "test": {
      "dependsOn": ["generate", "^generate", "^typecheck"]
    },
    "lint": {
      "dependsOn": ["generate", "^generate"]
    },

    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },

    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
